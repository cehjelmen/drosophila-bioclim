library(ggplot2)
library(phytools)
library(dplyr)
library(viridis)
#pulling in data
dat<-read.csv("ClimateData14June2024.csv")
#pulling in data
#dat<-read.csv("ClimateData14June2024.csv")
dat<-read.csv("data/climate_data_drosophila_Sept17.csv")
str(dat)
#read in tree file
#there are 100 trees
trees<-read.nexus("data/drostrees.nex")
#consensus tree
con.tree<-read.tree("data/mytree2.tre")
#variables we want to look at
to.compare<-colnames(dat)
dat$MbDNA_Male<-null
dat$MbDNA_Male<-NULL
length(names(dat))
dat[14:17]<-NULL
length(names(dat))
str(dat)
dat[8:10]<-NULL
str(dat)
dat$Subgenus<-NULL
str(dat)
#variables we want to look at
to.compare<-colnames(dat)
#make an output table
#change number of rows to correspond to value
output.table.lm<-matrix(,nrow=(length(to.compare)-3), ncol=8)
#name columns
colnames(output.table.lm)<-c("Variable",
"Estimate", "StError", "tvalue",
"pvalue", "rsquare",
"Adjrsquare", "Fstat")
#loop through linear model and make table
#i<-7
for(i in 4:length(to.compare)){
#subset data for variable
#spec.data<-dat$Species[is.na(dat[i])==FALSE]
foo<-subset(dat, subset=(is.na(dat[i])==FALSE))
#str(foo)
#make linear model
linearmod<-lm(log(foo$MbDNA_Female)~foo[[i]])
testing<-summary(linearmod)
#info we want
#variable
output.table.lm[(i-3),1]<-names(dat[i])
#estimate
output.table.lm[(i-3),2]<-testing$coefficients[2]
#st error
output.table.lm[(i-3),3]<-testing$coefficients[4]
#t-value
output.table.lm[(i-3),4]<-testing$coefficients[6]
#p-value
output.table.lm[(i-3),5]<-testing$coefficients[8]
#r-square
output.table.lm[(i-3),6]<-testing$r.squared
#adj. R square
output.table.lm[(i-3),7]<-testing$adj.r.squared[1]
#f stat
output.table.lm[(i-3),8]<-testing$fstatistic[1]
}
View(output.table.lm)
